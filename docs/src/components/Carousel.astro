---
interface Slide {
  src: string;
  category: string;
  mode: string;
  speed: string;
  userInstruction: string;
  vlaTasks: string[];
  alt?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const slidesData = slides.map((s) => ({
  category: s.category,
  userInstruction: s.userInstruction,
  vlaTasks: s.vlaTasks,
}));
---

<section
  id="capabilities"
  class="relative mt-12 carousel-breakout scroll-mt-16"
  aria-label="Capability demos"
>
  <div
    id="carousel-track"
    class="carousel-track flex overflow-x-auto snap-x snap-mandatory gap-6 scroll-smooth scrollbar-hide"
  >
    {
      slides.map((slide, i) => (
        <figure
          class="carousel-slide snap-center shrink-0 relative rounded-2xl overflow-hidden ring-1 ring-line bg-bg-elev"
          data-slide={i}
        >
          <video
            src={slide.src}
            class="w-full h-auto block"
            autoplay
            loop
            muted
            playsinline
            controls
            controlslist="nodownload"
            preload={i === 0 ? "auto" : "metadata"}
            aria-label={slide.alt ?? slide.userInstruction}
          ></video>

          {/* Top-left: mode + speed (subtle dark tag) — moved up to avoid native video controls */}
          <span class="absolute top-5 left-5 px-4 py-2 bg-black/65 backdrop-blur-sm text-white text-[14px] font-mono tracking-tight rounded-md">
            {slide.mode} &middot; {slide.speed}
          </span>

          {/* Top-right: stacked white tags. bold = category, italic = user */}
          <div class="absolute top-5 right-5 flex flex-col items-end gap-1.5">
            <span class="block px-4 py-2 bg-white/95 text-fg text-[15px] font-display font-semibold rounded-md shadow-sm">
              {slide.category}
            </span>
            <span class="block px-4 py-2 bg-white/95 text-fg text-[15px] font-display italic rounded-md shadow-sm">
              &ldquo;{slide.userInstruction}&rdquo;
            </span>
          </div>
        </figure>
      ))
    }
  </div>

  {/* Controls */}
  <div class="mt-6 flex flex-col items-center gap-3">
    <div class="flex gap-2">
      <button
        id="carousel-prev"
        type="button"
        aria-label="Previous"
        class="w-10 h-10 rounded-full bg-fg/15 hover:bg-fg/25 text-fg flex items-center justify-center transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path
            d="M10 12L6 8l4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        id="carousel-next"
        type="button"
        aria-label="Next"
        class="w-10 h-10 rounded-full bg-fg hover:bg-fg/85 text-bg flex items-center justify-center transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path
            d="M6 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <div class="text-[12px] font-mono text-fg-muted">
      <span id="carousel-current">1</span> / {slides.length}
    </div>
  </div>

  {/* Caption — category alone (centered, larger), then User + Agent rows */}
  <div
    class="mt-12 px-6 max-w-3xl mx-auto font-display text-fg"
    aria-live="polite"
  >
    {/* Category as centered heading */}
    <h2
      id="caption-category"
      class="text-center text-[clamp(1.5rem,2.4vw,2rem)] font-semibold leading-tight mb-10"
    >
    </h2>

    {/* User row + Agent → VLA row */}
    <dl
      class="grid grid-cols-[max-content_1fr] gap-x-8 gap-y-5 items-baseline"
    >
      <dt class="font-display text-[13px] uppercase tracking-[0.15em] text-fg-muted pt-1.5">
        User
      </dt>
      <dd
        id="caption-user"
        class="font-display italic text-[19px] leading-[1.4] text-fg"
      >
      </dd>

      <dt class="font-display text-[13px] uppercase tracking-[0.15em] text-fg-muted pt-1.5">
        Agent &rarr; VLA
      </dt>
      <dd>
        <ol id="caption-vla" class="space-y-2 leading-[1.5]"></ol>
      </dd>
    </dl>
  </div>
</section>

<style>
  .carousel-breakout {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .carousel-track {
    --slide-w: min(85vw, 1280px);
    padding-inline: max(1.5rem, calc((100vw - var(--slide-w)) / 2));
    padding-block: 0.25rem;
  }

  .carousel-slide {
    width: min(85vw, 1280px);
  }

  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<!--
  VLA task list animation styles must be global because the <li> elements
  are generated at runtime via innerHTML (Astro's default scoped styles
  would not match them).
-->
<style is:global>
  .vla-item {
    font-family: var(--font-display);
    line-height: 1.85;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-fg-muted);
    opacity: 0.5;
    transition:
      font-size 0.4s ease,
      color 0.4s ease,
      opacity 0.4s ease;
  }
  .vla-item.single,
  .vla-item.active {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-fg);
    opacity: 1;
  }
</style>

<script define:vars={{ slidesData }}>
  const track = document.getElementById("carousel-track");
  const currentEl = document.getElementById("carousel-current");
  const categoryEl = document.getElementById("caption-category");
  const userEl = document.getElementById("caption-user");
  const vlaEl = document.getElementById("caption-vla");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  if (track && currentEl && categoryEl && userEl && vlaEl) {
    const slides = Array.from(track.querySelectorAll("figure[data-slide]"));
    let cycleTimer = null;

    function stopCycle() {
      if (cycleTimer) {
        clearInterval(cycleTimer);
        cycleTimer = null;
      }
    }

    function startCycle(numTasks) {
      stopCycle();
      if (numTasks <= 1) return;
      let active = 0;
      const setActive = (idx) => {
        const items = vlaEl.querySelectorAll(".vla-item");
        items.forEach((li, i) =>
          li.classList.toggle("active", i === idx),
        );
      };
      setActive(0);
      cycleTimer = setInterval(() => {
        active = (active + 1) % numTasks;
        setActive(active);
      }, 2200);
    }

    function renderTasks(tasks) {
      if (tasks.length === 1) {
        vlaEl.innerHTML = `<li class="vla-item single">${tasks[0]}</li>`;
        stopCycle();
        return;
      }
      vlaEl.innerHTML = tasks
        .map(
          (t, i) =>
            `<li class="vla-item" data-task-idx="${i}">${i + 1}. ${t}</li>`,
        )
        .join("");
      startCycle(tasks.length);
    }

    function render(idx) {
      const data = slidesData[idx];
      if (!data) return;
      currentEl.textContent = String(idx + 1);
      categoryEl.textContent = data.category;
      userEl.textContent = `\u201C${data.userInstruction}\u201D`;
      renderTasks(data.vlaTasks);
    }

    function findCenterIndex() {
      const trackRect = track.getBoundingClientRect();
      const centerX = trackRect.left + trackRect.width / 2;
      let closest = 0;
      let minDist = Infinity;
      slides.forEach((slide, i) => {
        const rect = slide.getBoundingClientRect();
        const slideCenter = rect.left + rect.width / 2;
        const dist = Math.abs(slideCenter - centerX);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });
      return closest;
    }

    let scrollTimer;
    track.addEventListener("scroll", () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        render(findCenterIndex());
      }, 80);
    });

    function scrollToSlide(idx) {
      const slide = slides[idx];
      if (!slide) return;
      const offset =
        slide.offsetLeft - (track.offsetWidth - slide.offsetWidth) / 2;
      track.scrollTo({ left: offset, behavior: "smooth" });
    }

    prevBtn?.addEventListener("click", () => {
      const idx = findCenterIndex();
      scrollToSlide(Math.max(0, idx - 1));
    });
    nextBtn?.addEventListener("click", () => {
      const idx = findCenterIndex();
      scrollToSlide(Math.min(slides.length - 1, idx + 1));
    });

    track.tabIndex = 0;
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        prevBtn?.click();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        nextBtn?.click();
      }
    });

    render(0);
  }
</script>
