---
import { asset } from "../lib/asset";

interface TeamMember {
  name: string;
  nameZh: string;
  initials: string;
  homepage: string | null;
  image: string | null;
  role?: string;
}

const team: TeamMember[] = [
  {
    name: "Qing Lian",
    nameZh: "连庆",
    initials: "QL",
    homepage: "https://lianqing11.github.io",
    image: asset("profile/lianqing.jpg"),
    role: "Project Leader",
  },
  {
    name: "Jinghang Li",
    nameZh: "李景行",
    initials: "JL",
    homepage: "https://jinghangli.github.io",
    image: asset("profile/lijinghang.jpg"),
  },
  {
    name: "Yuhan Xi",
    nameZh: "席煜涵",
    initials: "XX",
    homepage: null,
    image: asset("profile/xiyuhan.jpg"),
  },
  {
    name: "Qing Jiang",
    nameZh: "蒋擎",
    initials: "QJ",
    homepage: "https://mountchicken.github.io",
    image: asset("profile/jiangqing.jpg"),
  },
];
---

<section
  id="contributor"
  class="mt-20 font-display scroll-mt-16"
>
  <h2
    class="text-[clamp(1.5rem,2.4vw,1.875rem)] font-medium text-fg leading-tight mb-12"
  >
    Contributor
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10">
    {
      team.map((person) => (
        <div class="group">
          <div class="aspect-square bg-bg-elev rounded-2xl ring-1 ring-line overflow-hidden flex items-center justify-center transition-all duration-300 group-hover:ring-fg-muted">
            {person.image ? (
              <img
                src={person.image}
                alt={person.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <span class="font-display text-[clamp(2.5rem,6vw,4rem)] font-medium text-fg-faint select-none">
                {person.initials}
              </span>
            )}
          </div>
          <h3 class="mt-4 font-display text-[1.125rem] font-semibold text-fg leading-tight">
            {person.name}
          </h3>
          <p class="font-display text-[0.95rem] text-fg-muted leading-tight mt-0.5">
            {person.nameZh}
          </p>
          {person.role && (
            <p class="font-mono text-[12px] uppercase tracking-[0.16em] text-fg mt-2">
              {person.role}
            </p>
          )}
          {person.homepage && (
            <a
              href={person.homepage}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-block font-display text-[14px] text-fg-muted underline underline-offset-[5px] decoration-1 decoration-fg-muted/50 hover:text-fg hover:decoration-fg transition-colors"
            >
              Homepage &rarr;
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>
